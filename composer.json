{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "jaisato/laravel-forum",
    "type": "project",
    "description": "Bilingual community forum built with Laravel 13, Inertia 3 + Vue 3, a versioned REST API and AI-assisted moderation.",
    "keywords": [
        "laravel",
        "forum",
        "inertia",
        "vue",
        "ai"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "dedoc/scramble": "^0.13.49",
        "filament/filament": "^5.10",
        "http-interop/http-factory-guzzle": "^1.2",
        "inertiajs/inertia-laravel": "^3.5",
        "intervention/image": "^4.4",
        "laravel/ai": "^1.3",
        "laravel/fortify": "^1.41",
        "laravel/framework": "^13.38",
        "laravel/horizon": "^5.50",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.9",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.23",
        "league/commonmark": "^2.10",
        "meilisearch/meilisearch-php": "^1.17"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "analyse": [
            "Composer\\Config::disableProcessTimeout",
            "phpstan analyse --memory-limit=2G"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "pest --parallel --fail-on-warning"
        ],
        "test:coverage": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "pest --parallel --fail-on-warning --coverage --min=95"
        ],
        "ci": [
            "@lint:check",
            "@analyse",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4.1"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
