{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write resources/ tests/js/",
        "format:check": "prettier --check resources/ tests/js/",
        "types:check": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@fontsource-variable/instrument-sans": "^5.3.0",
        "@inertiajs/vite": "^3.11.0",
        "@inertiajs/vue3": "^3.11.0",
        "@laravel/passkeys": "^0.4.1",
        "@lucide/vue": "^1.70.0",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^3.2.1",
        "laravel-vue-i18n": "^2.9.0",
        "reka-ui": "^2.9.8",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.45",
        "vue-input-otp": "^0.4.0",
        "vue-sonner": "^2.0.9"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "^5.1.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.12.0",
        "happy-dom": "^21.0.4",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vitest": "^5.0.5",
        "vue-tsc": "3.3.13"
    },
    "overrides": {
        "@tailwindcss/typography": {
            "postcss-selector-parser": "^7.1.7"
        },
        "minimatch": "^11.0.3",
        "glob": "^14.0.3"
    },
    "//": [
        "devDependencies.vue-tsc is pinned to 3.3.13. 3.3.14 generates invalid code",
        "for a template attribute value that contains `//` (placeholder=\"https://\" in",
        "resources/js/pages/settings/Profile.vue) and then fails with TS2339",
        "\"Property 'value' does not exist\" on the bindings the template reads after",
        "it: vuejs/language-tools#6322. Go back to a caret range with the first",
        "release that fixes it; .github/dependabot.yml skips 3.3.14 until then."
    ]
}
