{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write resources/ tests/js/",
        "format:check": "prettier --check resources/ tests/js/",
        "types:check": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@fontsource-variable/instrument-sans": "^5.3.0",
        "@inertiajs/vite": "^3.9.1",
        "@inertiajs/vue3": "^3.9.1",
        "@laravel/passkeys": "^0.2.0",
        "@lucide/vue": "^1.17.0",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^3.2.0",
        "laravel-vue-i18n": "^2.9.0",
        "reka-ui": "^2.9.8",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.44",
        "vue-input-otp": "^0.3.2",
        "vue-sonner": "^2.0.9"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^22.20.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "^5.0.5",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "happy-dom": "^21.0.4",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    },
    "overrides": {
        "@tailwindcss/typography": {
            "postcss-selector-parser": "^7.1.7"
        }
    }
}
