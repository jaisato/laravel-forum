# Environment for the test suite. Laravel loads this file instead of .env
# whenever APP_ENV=testing, which phpunit.xml sets before the app boots.
#
# It is tracked on purpose, and it is safe to track: every value here is a
# fixture. The database is an in-memory SQLite thrown away at the end of each
# test, mail and queues never leave the process. No value addresses a real
# service, so this file is not a credential - the deployed ones stay in the
# untracked .env, as .gitignore enforces.
#
# Without it, a clean clone could not run the suite at all: every environment
# file was untracked, so the app booted with no APP_KEY and every test died on
# MissingAppKeyException - and phpdotenv's search for a missing .env raised a
# PHP warning that PHPUnit attached to each test on top.
#
# APP_KEY is the one value that is NOT written here. It first shipped with a
# real generated key, on the reasoning above - it encrypts only values that live
# and die inside one test run. GitGuardian flagged it, and it was right to: a
# valid Laravel key committed to the repository is indistinguishable from a
# production one to anything reading the file, and the failure mode is somebody
# copying this file to .env. The argument that it protects nothing only holds as
# long as nobody does that.
#
# It is generated instead, once per clone, by `composer test` and by the CI job.
# Leave the line empty here.

APP_NAME=Forum
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

BCRYPT_ROUNDS=4
CACHE_STORE=array
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

TELESCOPE_ENABLED=false
PULSE_ENABLED=false
