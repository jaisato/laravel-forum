# -----------------------------------------------------------------------------
# Laravel Forum - local development with Docker Compose (compose.yaml).
# Copy to .env (`make setup` does it) and run `php artisan key:generate`.
# Hostnames such as `postgres`, `redis` or `meilisearch` are Compose services.
# Production uses .env.production.example instead.
# -----------------------------------------------------------------------------

APP_NAME="Laravel Forum"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 18 with pgvector (service `postgres`).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=forum
DB_USERNAME=forum
DB_PASSWORD=forum-dev-password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Redis 8 (service `redis`): cache, sessions, queues and rate limiters.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit catches every email locally: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@forum.test"
MAIL_FROM_NAME="${APP_NAME}"

# Full-text search with Meilisearch (service `meilisearch`).
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=forum-dev-master-key-change-me

# Inertia SSR. In development the Vite dev server renders pages itself;
# in production the `ssr` service listens on port 13714.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://ssr:13714

# Development seed account (php artisan migrate --seed).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password

# -----------------------------------------------------------------------------
# AI features (laravel/ai). Off by default: the forum works without any key.
# See docs/06-ia.md for providers, costs and the local Ollama alternative.
# -----------------------------------------------------------------------------
FORUM_AI_ENABLED=false
FORUM_AI_TEXT_PROVIDER=anthropic
FORUM_AI_TEXT_MODEL=claude-opus-5-5
# Optional per-feature models (empty = FORUM_AI_TEXT_MODEL). For high-volume
# moderation a cheaper model such as claude-haiku-5-5 is usually enough.
FORUM_AI_MODERATION_MODEL=
FORUM_AI_SUMMARY_MODEL=
FORUM_AI_TAGS_MODEL=
FORUM_AI_EMBEDDINGS_PROVIDER=openai
FORUM_AI_EMBEDDINGS_MODEL=text-embedding-3-small
FORUM_AI_EMBEDDINGS_DIMENSIONS=1536

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Local models with `docker compose --profile ai up -d ollama`.
OLLAMA_URL=http://ollama:11434

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
