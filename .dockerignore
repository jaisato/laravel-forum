# Build context of the Dockerfile: what the images are built from, and
# nothing else. Everything is left out but the list below, so whatever else
# a checkout gathers never gets in: secrets (.env.production, the editors'
# and agents' settings), local data (a SQLite database, a dump, storage) or
# what the build makes again inside (vendor, node_modules, Wayfinder, Vite,
# SSR). A new file the build needs goes in the list. The Dockerfile creates
# storage and bootstrap/cache, empty.
*

# The application and its PHP dependencies
!app
!artisan
!bootstrap
!composer.json
!composer.lock
!config
!database
!lang
!public
!resources
!routes

# The assets (Vite) and the images' own settings (PHP, Nginx, entrypoint)
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!docker

# Generated or local even in there, as in .gitignore
**/.DS_Store
bootstrap/cache/*.php
bootstrap/ssr
database/**/*.sqlite*
public/build
public/css/filament
public/fonts/filament
public/fonts-manifest.dev.json
public/hot
public/js/filament
public/storage
public/vendor
resources/js/actions
resources/js/routes
resources/js/wayfinder
